# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ห้าม commit ขึ้น git)

# Ollama connection
OLLAMA_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen3:8b

# ต้องส่งมาใน header "X-API-Key" ทุก request เพื่อเรียก API นี้
# สร้างค่าใหม่ด้วยคำสั่ง: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-generate-a-real-secret

# รายชื่อ origin ที่อนุญาตให้เรียก API นี้ได้ (คั่นด้วย comma ถ้ามีหลายค่า)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# จำกัดจำนวน request ต่อ IP เพื่อกัน abuse / ค่าใช้จ่ายบานปลาย
RATE_LIMIT=10/minute
